# Copy this file to .env and adjust values. Never commit the real .env file.

# ---- Node ----
NODE_ENV=development
PORT=4000

# ---- MongoDB ----
MONGODB_URI=mongodb://mongo:27017/finpulse?replicaSet=rs0

# ---- Kafka ----
KAFKA_BROKERS=kafka:9092
KAFKA_CLIENT_ID=finpulse
KAFKA_GROUP_ID=finpulse-consumer-group

# ---- Market data pipeline ----
# Interval, in seconds, between simulated/live price ticks.
MARKET_DATA_INTERVAL_SECONDS=5
# Leave both blank to run in DEMO mode with the built-in simulator.
# Set both to switch the producer to LiveMarketDataProvider (see pipeline/src/providers/liveProvider.ts).
MARKET_DATA_API_KEY=
MARKET_DATA_API_URL=

# ---- Frontend ----
FRONTEND_URL=http://localhost:5173

# ---- Auth ----
# Generate a long random value, e.g.: openssl rand -hex 32
JWT_SECRET=replace-this-with-a-long-random-value
